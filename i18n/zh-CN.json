{
  "name": "Finch消息提醒",
  "description": "给 Finch 加上提示音和刘海小鸟：任务完成、中断、失败、等待确认等事件可分别配置系统音、14 种趣味音效或自定义音频；任务完成时，Finch 小鸟背着小邮包从刘海里钻出来，在菜单栏刘海左侧蹦跳、做小动作，点它直接打开那个会话。仅支持 macOS。",
  "contributes": {
    "settingsMenu": {
      "tooltip": "Finch消息提醒"
    }
  },
  "settings": {
    "fields": {
      "enabled": {
        "label": "开启提示音"
      },
      "volume": {
        "label": "音量（0-100）"
      },
      "onlyWhenUnviewed": {
        "label": "只在没看该会话时响",
        "description": "Finch 不在前台，或该会话有未读结果时才响"
      },
      "alwaysRing": {
        "label": "这些事件即使正在看也响",
        "description": "中断通常是你自己按的，默认总是响",
        "options": {
          "completed": {
            "label": "任务完成"
          },
          "interrupted": {
            "label": "任务中断"
          },
          "failed": {
            "label": "出错失败"
          },
          "waiting": {
            "label": "等待确认"
          },
          "started": {
            "label": "任务开始"
          },
          "retry": {
            "label": "自动重试"
          },
          "compacted": {
            "label": "上下文压缩完成"
          },
          "toolError": {
            "label": "工具报错"
          }
        }
      },
      "quietHours": {
        "label": "免打扰时段",
        "placeholder": "例如 23:00-08:00，留空不启用"
      },
      "notchBird": {
        "label": "刘海送信小鸟",
        "description": "事件发生时，Finch 小鸟背着小邮包从刘海里钻出来，在刘海左侧的菜单栏黑边里蹦跳、伸懒腰、哼歌、打盹；鼠标移上去它会亮出信，点它直接打开那个会话"
      },
      "notchBirdEvents": {
        "label": "哪些事件放飞小鸟",
        "options": {
          "completed": {
            "label": "任务完成"
          },
          "interrupted": {
            "label": "任务中断"
          },
          "failed": {
            "label": "出错失败"
