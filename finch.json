{
  "manifestVersion": 1,
  "id": "finch-message-alert",
  "minVersion": "1.8.0",
  "name": "Finch Message Alerts",
  "description": "Sound cues and a notch bird for Finch: pick a macOS system sound, one of 14 fun sounds or your own audio for task completed, interrupted, failed, waiting and more. When a task finishes, a little Finch bird with a mail bag pops out of the camera notch and hops along the menu bar; click it to open that conversation. macOS only.",
  "main": "dist/index.js",
  "activationEvents": [
    "onStartup"
  ],
  "miniToolType": "community",
  "categories": [
    "productivity"
  ],
  "contributes": {
    "settingsMenu": {
      "icon": "music",
      "tooltip": "Finch Message Alerts"
    },
    "tools": true
  },
  "permissions": {
    "filesystem": "read",
    "network": false,
    "shell": true
  },
  "settings": {
    "fields": [
      {
        "key": "enabled",
        "type": "boolean",
        "label": "Play sound cues",
        "default": true
      },
      {
        "key": "volume",
        "type": "number",
        "label": "Volume (0-100)",
        "default": 60
      },
      {
        "key": "onlyWhenUnviewed",
        "type": "boolean",
        "label": "Only when I am not looking",
        "description": "Rings only when Finch is in the background or that conversation has an unread result",
        "default": true
      },
      {
        "key": "alwaysRing",
        "type": "multiselect",
        "label": "Always ring for these events",
        "description": "Interruptions are usually your own doing, so they always ring by default",
        "options": [
          {
            "value": "completed",
            "label": "Task completed"
          },
          {
            "value": "interrupted",
            "label": "Task interrupted"
          },
          {
            "value": "failed",
            "label": "Failed"
          },
          {
            "value": "waiting",
            "label": "Waiting for you"
          },
          {
            "value": "started",
            "label": "Task started"
          },
          {
            "value": "retry",
            "label": "Auto retry"
          },
          {
            "value": "compacted",
            "label": "Context compacted"
          },
          {
            "value": "toolError",
            "label": "Tool error"
          }
        ],
        "default": [
          "interrupted"
        ]
      },
      {
        "key": "quietHours",
        "type": "string",
        "label": "Quiet hours",
        "placeholder": "e.g. 23:00-08:00, leave empty to disable"
      },
      {
        "key": "notchBird",
        "type": "boolean",
        "label": "Notch letter bird",
        "description": "A Finch bird with a little mail bag pops out of the camera notch and hops, stretches, sings and naps in the menu bar left of the notch; hover to see the letter, click to open that conversation",
        "default": true
      },
      {
        "key": "notchBirdEvents",
        "type": "multiselect",
        "label": "Events that release the bird",
        "options": [
          {
            "value": "completed",
            "label": "Task completed"
          },
          {
            "value": "interrupted",
            "label": "Task interrupted"
          },
          {
            "value": "failed",
            "label": "Failed"
          },
          {
            "value": "waiting",
            "label": "Waiting for you"
          },
          {
            "value": "started",
            "label": "Task started"
          },
          {
            "value": "retry",
            "label": "Auto retry"
          },
          {
            "value": "compacted",
            "label": "Context compacted"
          },
          {
            "value": "toolError",
            "label": "Tool error"
          }
        ],
        "default": [
          "completed"
        ]
      },
      {
        "key": "notchBirdSeconds",
        "type": "number",
        "label": "How long the bird stays (seconds)",
        "description": "Ignored when \"Stay until I click it\" is on",
        "default": 15
      },
      {
        "key": "notchBirdUntilClick",
        "type": "boolean",
        "label": "Stay until I click it",
        "description": "The bird keeps waiting in the menu bar until you click it to open the conversation. It also flies home once you have read the conversation some other way",
        "default": true
      },
